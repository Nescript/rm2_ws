<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="$(find rm2_description)/urdf/common/friction.urdf.xacro"/>


    <xacro:property name="front_wheel_offset_x" value="0.180"/>
    <xacro:property name="back_wheel_offset_x" value="0.115"/>
    <xacro:property name="wheel_offset_y" value="0.049"/>
    <xacro:property name="wheel_offset_z" value="0.0"/>


    <xacro:friction_wheel prefixs="left_front" connected_to="pitch"
                          wheel_x_offset="${front_wheel_offset_x}" wheel_y_offset="${wheel_offset_y}"
                          wheel_z_offset="${wheel_offset_z}"       wheel_r_offset="1.047"/>

    <xacro:friction_wheel prefixs="mid_front" connected_to="pitch"
                          wheel_x_offset="${front_wheel_offset_x}" wheel_y_offset="0.01"
                          wheel_z_offset="${-wheel_offset_y}"       wheel_r_offset="1.57"/>

    <xacro:friction_wheel prefixs="right_front" connected_to="pitch"
                          wheel_x_offset="${front_wheel_offset_x}" wheel_y_offset="${-wheel_offset_y}"
                          wheel_z_offset="${wheel_offset_z}"       wheel_r_offset="-1.047"/>

    <xacro:friction_wheel prefixs="left_back" connected_to="pitch"
                          wheel_x_offset="${back_wheel_offset_x}"  wheel_y_offset="${wheel_offset_y}"
                          wheel_z_offset="${wheel_offset_z}"       wheel_r_offset="1.047"/>

    <xacro:friction_wheel prefixs="mid_back" connected_to="pitch"
                          wheel_x_offset="${back_wheel_offset_x}" wheel_y_offset="0.01"
                          wheel_z_offset="${-wheel_offset_y}"      wheel_r_offset="1.57"/>

    <xacro:friction_wheel prefixs="right_back" connected_to="pitch"
                          wheel_x_offset="${back_wheel_offset_x}" wheel_y_offset="${-wheel_offset_y}"
                          wheel_z_offset="${wheel_offset_z}"      wheel_r_offset="-1.047"/>


    <link name="trigger">
        <visual>
            <orgin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://rm2_description/meshes/hero2/trigger.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://rm2_description/meshes/hero2/trigger.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.999809"/>
            <origin xyz="-0.000971 0.032668 -0.132181"/>
            <inertia ixx="5.306E-03" ixy="-3.6857827E-05" ixz="1.580E-04" iyy="5.246E-03"
                     iyz="-3.665E-04" izz="1.528E-03"/>
        </inertial>
    </link>

    <joint name="trigger_joint" type="continuous">
        <origin xyz="-0.163281 0 0.0965" rpy="0 0 0"/>
        <dynamics damping="0.0" friction="0.01"/>
        <limit effort="7.0" velocity="35" lower="-1E16" upper="1E16"/>
        <parent link="base_link"/>
        <child link="trigger"/>
        <axis xyz="0 0 1 "/>
    </joint>

</robot>
