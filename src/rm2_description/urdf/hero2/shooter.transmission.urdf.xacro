        <joint name="mid_back_friction_wheel_joint" role="actuated">
            <mechanical_reduction>1</mechanical_reduction>
        </joint>
        <actuator name="mid_back_friction_wheel_joint_motor" role="actuated">
            <mechanical_reduction>1</mechanical_reduction>
        </actuator>
    </transmission>

    <transmission name="trans_right_back_friction_wheel_joint">
        <type>transmission_interface/SimpleTransmission</type>
