        </actuator>
    </transmission>

    <transmission name="trans_left_back_friction_wheel_joint">
        <type>transmission_interface/SimpleTransmission</type>
        <plugin>transmission_interface/SimpleTransmission</plugin>
        <joint name="left_back_friction_wheel_joint" role="actuated">
            <mechanical_reduction>1</mechanical_reduction>
        </joint>
        <actuator name="left_back_friction_wheel_joint_motor" role="actuated">
            <mechanical_reduction>1</mechanical_reduction>
        </actuator>
    </transmission>

