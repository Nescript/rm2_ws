<?xml version="1.0"?>
<robot>


    <transmission name="trans_trigger_joint">
        <type>transmission_interface/SimpleTransmission</type>
        <plugin>transmission_interface/SimpleTransmission</plugin>
        <joint name="trigger_joint" role="actuated">
            <mechanical_reduction>26.851</mechanical_reduction>
            <offset>2.2</offset>
        </joint>
        <actuator name="trigger_joint_motor" role="actuated">
            <mechanical_reduction>26.851</mechanical_reduction>
        </actuator>
    </transmission>

    <transmission name="trans_left_front_friction_wheel_joint">
        <type>transmission_interface/SimpleTransmission</type>
