<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="silver">
    <xacro:macro name="silver" params="connected_to">
        <xacro:property name="lifter_upper_limit" value="0.186"/>
        <xacro:property name="lifter_lower_limit" value="0"/>
        <xacro:property name="lifter_velocity" value="1.4"/>
        <xacro:property name="lifter_effort" value="178.57"/>

        <xacro:property name="pusher_upper_limit" value="0."/>
        <xacro:property name="pusher_lower_limit" value="-0.056"/>
        <xacro:property name="pusher_velocity" value="0.54"/>
        <xacro:property name="pusher_effort" value="55.56"/>

        <xacro:property name="rotator_upper_limit" value="1.7"/>
        <xacro:property name="rotator_lower_limit" value="0"/>
        <xacro:property name="rotator_velocity" value="18.6"/>
        <xacro:property name="rotator_effort" value="13.42"/>

        <link name="silver_lifter_link">
            <visual>
                <origin xyz="0. 0. 0." rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://rm2_description/meshes/engineer2/silver_lifter_link.stl"/>
                </geometry>
            </visual>
            <inertial>
                <mass value="0.648926"/>
                <origin xyz="-0.007801 0.004875 0.188146"/>
                <inertia ixx="1.370e-2" ixy="-1.425e-4" ixz="2.659e-4" iyy="6.190e-3" iyz="5.942e-4" izz="7.922e-3"/>
            </inertial>
            <collision>
                <origin xyz="0. 0. 0." rpy="0. 0. 0."/>
                <geometry>
                    <mesh filename="package://rm2_description/meshes/engineer2/silver_lifter_link.stl"/>
                </geometry>
            </collision>
        </link>

        <link name="silver_pusher_link">
            <visual>
                <origin xyz="0. 0. 0." rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://rm2_description/meshes/engineer2/silver_pusher_link.stl"/>
                </geometry>
            </visual>
            <inertial>
                <mass value="1.664746"/>
                <origin xyz="0.075241 -0.011559 0.018618"/>
                <inertia ixx="8.693e-3" ixy="3.388e-3" ixz="1.479e-3" iyy="7.273e-3" iyz="1.8572448e-5" izz="1.295e-2"/>
            </inertial>
            <collision>
                <origin xyz="0. 0. 0." rpy="0. 0. 0."/>
                <geometry>
                    <mesh filename="package://rm2_description/meshes/engineer2/silver_pusher_link.stl"/>
                </geometry>
            </collision>
        </link>

        <link name="silver_gripper_link">
            <visual>
                <origin xyz="0. 0. 0." rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://rm2_description/meshes/engineer2/silver_gripper_link.stl"/>
                </geometry>
            </visual>
            <inertial>
                <mass value="0.438981"/>
                <origin xyz="-0.054346 0.002771 0.00171"/>
                <inertia ixx="1.346e-2" ixy="-6.4517815e-5" ixz="6.28402e-6" iyy="4.031e-4" iyz="1.722535e-6" izz="1.363e-2"/>
            </inertial>
            <collision>
                <origin xyz="0. 0. 0." rpy="0. 0. 0."/>
                <geometry>
                    <mesh filename="package://rm2_description/meshes/engineer2/silver_gripper_link.stl"/>
                </geometry>
            </collision>
        </link>

        <joint name="silver_lifter_joint" type="prismatic">
            <parent link="${connected_to}"/>
            <child link="silver_lifter_link"/>
            <origin xyz="-0.220 0. 0.146" rpy="0 0 0"/>
            <axis xyz="0 0 1"/>
            <limit lower="${lifter_lower_limit}" upper="${lifter_upper_limit}"
                   velocity="${lifter_velocity}" effort="${lifter_effort}"/>
            <dynamics damping="0.0" friction="0.1"/>
        </joint>

        <joint name="silver_pusher_joint" type="prismatic">
            <parent link="silver_lifter_link"/>
            <child link="silver_pusher_link"/>
            <origin xyz="-0.020 0. 0.290" rpy="0 0 0"/>
            <axis xyz="1 0 0"/>
            <limit lower="${pusher_lower_limit}" upper="${pusher_upper_limit}"
                   velocity="${pusher_velocity}" effort="${pusher_effort}"/>
            <dynamics damping="0.0" friction="0.1"/>
        </joint>

        <joint name="silver_rotator_joint" type="revolute">
            <parent link="silver_pusher_link"/>
            <child link="silver_gripper_link"/>
            <origin xyz="-0.009 0. 0.050" rpy="0 0 0"/>
            <axis xyz="0 1 0"/>
            <limit lower="${rotator_lower_limit}" upper="${rotator_upper_limit}"
                   velocity="${rotator_velocity}" effort="${rotator_effort}"/>
            <dynamics damping="0.0" friction="0.1"/>
        </joint>

        <transmission name="trans_silver_lifter_joint">
            <type>transmission_interface/SimpleTransmission</type>
            <actuator name="silver_lifter_joint_motor">
                <mechanicalReduction>678.57</mechanicalReduction>
                                <!--19/0.028-->
            </actuator>
            <joint name="silver_lifter_joint">
                <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
                <offset>0</offset>
            </joint>
        </transmission>

        <transmission name="trans_silver_pusher_joint">
            <type>transmission_interface/SimpleTransmission</type>
            <actuator name="silver_pusher_joint_motor">
                <mechanicalReduction>2000</mechanicalReduction>
                                <!--36/0.018-->
            </actuator>
            <joint name="silver_pusher_joint">
                <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
                <offset>0</offset>
            </joint>
        </transmission>

        <transmission name="trans_silver_rotator_joint">
            <type>transmission_interface/SimpleTransmission</type>
            <actuator name="silver_rotator_joint_motor">
                <mechanicalReduction>-51</mechanicalReduction>
            </actuator>
            <joint name="silver_rotator_joint">
                <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
                <offset>0</offset>
            </joint>
        </transmission>
    </xacro:macro>
</robot>
