<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="$(find rm2_description)/urdf/common/friction.urdf.xacro"/>


    <xacro:property name="wheel_offset_x" value="0.047"/>
    <xacro:property name="wheel_offset_y" value="0.0365"/>
    <xacro:property name="wheel_offset_z" value="0.0004"/>


    <xacro:friction_wheel prefixs="left" connected_to="pitch"
                          wheel_x_offset="${wheel_offset_x}" wheel_y_offset="${wheel_offset_y}"
                          wheel_z_offset="${wheel_offset_z}"/>

    <xacro:friction_wheel prefixs="right" connected_to="pitch"
                          wheel_x_offset="${wheel_offset_x}" wheel_y_offset="${-wheel_offset_y}"
                          wheel_z_offset="${wheel_offset_z}"/>

    <link name="trigger">
        <inertial>
            <mass value="0.126797"/>
            <origin xyz="-0.00012 5.63e-8 0.034133"/>
            <inertia ixx="7.5663308e-05" ixy="2.132e-09" ixz="-2.32166e-07" iyy="7.4210991e-05"
                     iyz="-0.069e-09" izz="1.199e-04"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://rm2_description/meshes/drone/trigger.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://rm2_description/meshes/drone/trigger.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>
    </link>

    <joint name="trigger_joint" type="revolute">
        <origin xyz="0 0 -0.045" rpy="0 0 0"/>
        <dynamics damping="0.0" friction="0.01"/>
        <limit effort="3.0" velocity="43.54" lower="-1e16" upper="1e16"/>
        <parent link="base_link"/>
        <child link="trigger"/>
        <axis xyz="0 0 -1"/>
    </joint>

</robot>
