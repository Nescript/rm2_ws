<?xml version="1.0" ?>
<launch>
<!--     <arg name="robot_type" default="$(env ROBOT_TYPE)"/> -->

    <node pkg="robot_state_publisher" exec="robot_state_publisher" output="screen">
        <param name="robot_description" value="$(command 'xacro /home/dynamicx/rm2_ws/src/rm2_description/urdf/standard6/standard6.urdf.xacro')"/>
        <param name="use_sim_time" value="false"/>
    </node>

    <node pkg="controller_manager" exec="ros2_control_node" output="screen" launch-prefix="ethercat_grant">
        <param name="robot_description" value="$(command 'xacro /home/dynamicx/rm2_ws/src/rm2_description/urdf/standard6/standard6.urdf.xacro')"/>
        <param name="setupFile" value="$(find-pkg-share rm2_config)/config/rm2_ecat_hw/standard6.yaml"/>
        <param name="controllerConfigFile" value="$(find-pkg-share rm2_config)/config/rm2_ecat_hw/standard6.yaml"/>
<!--         <param from="$(find-pkg-share rm2_config)/config/rm2_controllers/controller_manager.yaml"/> -->
        <param from="$(find-pkg-share rm2_config)/config/rm2_controllers/standard6.yaml"/>
    </node>
</launch>
